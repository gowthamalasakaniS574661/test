# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rideshare_marketplace
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Matching weights (must sum to 1.0)
MATCH_WEIGHT_BID_PRICE=0.35
MATCH_WEIGHT_DRIVER_RATING=0.25
MATCH_WEIGHT_DISTANCE=0.20
MATCH_WEIGHT_TRUST_SCORE=0.20
MATCH_MAX_DISTANCE_KM=50
